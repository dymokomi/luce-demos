#prisma 4.0
def package "luce-demos" {
    str owner = "dymokomi"
    str version = "0.3.0"
    str kind = "package"
    str language = "luce"
    str description = "Small applications written in Luce, using the Luce Base luce-ui and luce-3d packages. Native compilation is the default. The standard library owns window, input and GPU backend resources; applications own their behavior."
    str readme = "README.md"

    def dependency "luce-ui" {
        str owner = "dymokomi"
        str version = "^0.15.0"
        str path = "../luce-ui"
    }

    def dependency "luce-3d" {
        str owner = "dymokomi"
        str version = "^0.8.0"
        str path = "../luce-3d"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-std"
    }
}
