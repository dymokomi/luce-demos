from ui import Application, Button, Text, VStack, HStack, Spacer
import ui

pub class Counter:
    let label: Text
    var count: int = 0

    pub func init(self, label: Text):
        self.label = label

    pub func increment(self) -> unit!:
        self.count += 1
        try self.label.set_text(f"Clicks {self.count}")

pub func main(arguments: list[str]) -> int!:
    var smoke = false
    for argument in arguments:
        if argument == "--smoke":
            smoke = true
        else:
            error(ui.invalid, f"unknown option: {argument}")

    let label = try Text("Clicks 0")
    let counter = Counter(label)
    let button = try Button("Add one")
    let clicked = try button.on_click(counter.increment)
    let content = try VStack([
        try Text("Luce UI"),
        try HStack([button, label, try Spacer()], spacing = 20.0),
        try Text("Click the button or use Tab and Space"),
        try Spacer()
    ], spacing = 20.0, padding = 24.0)
    let app = try Application(content, title = "Luce UI", width = 760, height = 360)
    try app.run(frame_limit = 12 if smoke else 0)
    clicked.disconnect()
    print("UI demo complete")
    return 0
