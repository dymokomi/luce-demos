from luce_ui.ui import Application, Button, Text, VStack, HStack, Spacer, SceneView
from luce_3d.graphics import Scene, Mesh, SphereGeometry, MeshLambertMaterial, Color, Vector3, Camera, AmbientLight, DirectionalLight
from luce_std import math
from luce_ui import ui

## Only application behavior lives here. The UI owns input and frame delivery;
## the scene view owns rendering and adjusts projection to its allocated space.
## A window draws only what was invalidated: each new angle invalidates the
## view, and while it spins the next frame is asked for (wake_after).
pub class Orbit:
    let sphere: Mesh
    let moon: Mesh
    let pause: Button
    let view: SceneView
    var app: Application? = none
    var spinning: bool = true
    var angle: float = 0.0

    pub func init(self, sphere: Mesh, moon: Mesh, pause: Button, view: SceneView):
        self.sphere = sphere
        self.moon = moon
        self.pause = pause
        self.view = view

    pub func toggle(self) -> unit!:
        let spinning = not self.spinning
        self.pause.set_text("Pause" if spinning else "Resume")
        self.spinning = spinning
        self.next_frame()

    pub func reset(self) -> unit!:
        self.set_angle(0.0)

    pub func update(self, elapsed: float) -> unit!:
        if not self.spinning:
            return
        self.set_angle(self.angle + math.min(elapsed, 0.1))
        self.next_frame()

    ## While it spins, a frame about 60 times a second.
    pub func next_frame(self):
        if not self.spinning:
            return
        if let app = self.app:
            app.wake_after(1.0 / 60.0)

    func set_angle(self, angle: float) -> unit!:
        self.sphere.set_rotation(Vector3(0.2, angle, 0.0))
        self.moon.set_position(Vector3(math.cos(angle) * 1.65,
            math.sin(angle * 0.7) * 0.4, math.sin(angle) * 1.65))
        self.angle = angle
        self.view.layout().invalidate()

pub func main(arguments: list[str]) -> int!:
    var smoke = false
    for argument in arguments:
        if argument == "--smoke":
            smoke = true
        else:
            error(ui.invalid, f"unknown option: {argument}")

    let geometry = SphereGeometry(1.0, 40, 24)
    let sphere = Mesh(geometry, MeshLambertMaterial(Color(0.06, 0.4, 0.95)))
    let moon = Mesh(geometry, MeshLambertMaterial(Color(1.0, 0.35, 0.06)))
    moon.set_scale(Vector3(0.22, 0.22, 0.22))
    let scene = Scene()
    scene.add(sphere)
    scene.add(moon)
    scene.add(AmbientLight(intensity = 0.25))
    scene.add(DirectionalLight(direction = Vector3(1.0, 1.0, 2.0), intensity = 0.9))
    let camera = Camera(50.0, near = 0.1, far = 100.0)
    camera.set_position(Vector3(0.0, 0.5, 5.0))
    let view = SceneView(scene, camera, width = 320.0, height = 240.0)
    let pause = Button("Pause")
    let reset = Button("Reset")
    let orbit = Orbit(sphere, moon, pause, view)
    let paused = pause.on_click(orbit.toggle)
    let reset_clicked = reset.on_click(orbit.reset)
    let content = VStack([
        HStack([Text("Luce 3D"), Spacer(), pause, reset]),
        view,
        Text("Realtime 3D in a UI viewport")
    ], spacing = 16.0, padding = 20.0)
    let app = Application(content, title = "Luce 3D", width = 960, height = 720)
    orbit.app = app
    let animated = app.on_frame(orbit.update)
    orbit.next_frame()
    app.run(frame_limit = 12 if smoke else 0)
    animated.disconnect()
    reset_clicked.disconnect()
    paused.disconnect()
    print("sphere demo complete")
    return 0
