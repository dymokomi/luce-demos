from ui_demo import Counter
from sphere import Orbit
from ui import Button, Text
from three import SphereGeometry, Mesh, MeshLambertMaterial, Color

pub func main(arguments: list[str]) -> int!:
    let label = Text("Clicks 0")
    let counter = Counter(label)
    let button = Button("Add one")
    let counted = button.on_click(counter.increment)
    button.click()
    button.click()
    assert(label.text() == "Clicks 2")
    counted.disconnect()
    button.click()
    assert(label.text() == "Clicks 2")
    let geometry = SphereGeometry()
    let material = MeshLambertMaterial(Color(0.1, 0.4, 1.0))
    let sphere = Mesh(geometry, material)
    let moon = Mesh(geometry, material)
    let pause = Button("Pause")
    let reset = Button("Reset")
    let orbit = Orbit(sphere, moon, pause)
    let paused = pause.on_click(orbit.toggle)
    let reset_clicked = reset.on_click(orbit.reset)
    orbit.update(0.05)
    let initial = sphere.rotation()
    assert(initial.y > 0.0)
    pause.click()
    assert(pause.text() == "Resume")
    orbit.update(0.05)
    assert(sphere.rotation() == initial)
    reset.click()
    assert(sphere.rotation().y == 0.0 and moon.position().x == 1.65)
    pause.click()
    assert(pause.text() == "Pause")
    orbit.update(0.05)
    assert(sphere.rotation().y > 0.0)
    paused.disconnect()
    reset_clicked.disconnect()
    print("ok demo counter, pause, resume, reset and animation")
    return 0
